# Environment Variables for Snowflake S3Compat API Test Suite
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to '.env' in the same directory
# 2. Fill in all the values with your actual test environment details
# 3. Never commit the .env file to version control
#
# USAGE:
# These environment variables will be automatically loaded when running tests
# using the provided Podman scripts or podman-compose.

# =============================================================================
# S3-Compatible Storage Configuration
# =============================================================================

# The primary bucket name for testing (must have versioning enabled)
# Example: my-test-bucket
BUCKET_NAME_1=

# Primary region where BUCKET_NAME_1 is located
# Example: us-east-1
REGION_1=

# Secondary region (different from REGION_1) for cross-region tests
# Example: us-west-2
REGION_2=

# S3-compatible endpoint URL (without https://)
# Example: s3.amazonaws.com or your-custom-s3-endpoint.com
END_POINT=

# =============================================================================
# Authentication Credentials
# =============================================================================

# Access key for authenticating to the S3-compatible storage
S3COMPAT_ACCESS_KEY=

# Secret key for authenticating to the S3-compatible storage
S3COMPAT_SECRET_KEY=

# =============================================================================
# Test Configuration
# =============================================================================

# A bucket that exists but is NOT accessible with the provided credentials
# This is used for negative testing scenarios
# Example: inaccessible-bucket
NOT_ACCESSIBLE_BUCKET=

# Prefix path in BUCKET_NAME_1 that contains over 1000 objects
# This is used for pagination/listing tests
# Example: test-data/large-dataset
PREFIX_FOR_PAGE_LISTING=

# Total number of objects under PREFIX_FOR_PAGE_LISTING
# Must be greater than 1000 for pagination tests to work correctly
# Example: 1500
PAGE_LISTING_TOTAL_SIZE=

# =============================================================================
# Optional: Maven Test Selection
# =============================================================================

# Uncomment and set to run specific tests instead of all tests
# Examples:
#   Run single test class: S3CompatApiTest
#   Run single test method: S3CompatApiTest#getObject
#   Run multiple tests: S3CompatApiTest#getObject+S3CompatApiTest#putObject
# MAVEN_TEST=S3CompatApiTest

# =============================================================================
# Notes
# =============================================================================
# 
# Bucket Requirements:
# - BUCKET_NAME_1 must have versioning enabled
# - You must have read/write permissions to BUCKET_NAME_1
# - NOT_ACCESSIBLE_BUCKET should exist but you should NOT have access to it
#
# Prefix Requirements:
# - PREFIX_FOR_PAGE_LISTING must contain more than 1000 objects
# - Objects can be of any size, but should exist before running tests
#
# Security:
# - Keep your .env file secure and never commit it to version control
# - Rotate credentials regularly
# - Use least-privilege access keys when possible